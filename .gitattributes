# Автоматически определять текстовые файлы и хранить их в репозитории с LF
* text=auto eol=lf

# Скрипты Windows — CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Бинарные файлы — не трогать
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.xlsx binary

# Lock-файл не нормализовать
package-lock.json -text